FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    cmake \
    build-essential \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Build and install whisper.cpp
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp.git && \
    cd whisper.cpp && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build build -j$(nproc) && \
    cmake --install build && \
    (cp build/bin/whisper-cli /usr/local/bin/whisper-cpp || true) && \
    (cp build/bin/main /usr/local/bin/whisper-cpp || true) && \
    mkdir -p /root/.local/bin && \
    cp /usr/local/bin/whisper-cpp /root/.local/bin/whisper-cpp && \
    ldconfig && \
    cd / && rm -rf /tmp/whisper.cpp

ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

WORKDIR /app
COPY . /app

RUN pip3 install --no-cache-dir -e .[dev]

CMD ["python3", "docker_test_run.py"]
